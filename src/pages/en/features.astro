---
import CTAButton from '@/components/common/CTAButton.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n/utils';

const t = useTranslations('en');

const freeFeatures = [
  { icon: '📧', title: t('features.privacy.title'), desc: t('features.privacy.desc') },
  { icon: '⚡', title: t('features.lightweight.title'), desc: t('features.lightweight.desc') },
  { icon: '💻', title: t('features.crossplatform.title'), desc: t('features.crossplatform.desc') },
  { icon: '🐕', title: t('features.animation.title'), desc: t('features.animation.desc') },
];

const premiumFeatures = [
  { icon: '🎯', title: t('features.spamdetection.title'), desc: t('features.spamdetection.desc') },
];
---

<BaseLayout
  title="Features - Motekita"
  description="Everything Motekita has to offer. Privacy protection, lightweight, cross-platform support and more."
>
  <div class="max-w-5xl mx-auto px-4 py-16 md:py-24">
    <!-- Breadcrumb -->
    <nav class="text-sm text-warm-gray-500 mb-8" aria-label="Breadcrumb">
      <a href="/en/" class="hover:text-primary-700 transition-colors">Home</a>
      <span class="mx-2" aria-hidden="true">›</span>
      <span class="text-warm-gray-900">{t('features.page.title')}</span>
    </nav>

    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-display font-bold text-warm-gray-900 mb-4 fade-in-up">
        {t('features.page.title')}
      </h1>
      <p class="text-lg text-warm-gray-600 max-w-xl mx-auto fade-in-up">
        {t('features.page.subtitle')}
      </p>
    </div>

    <!-- Free Features -->
    <section class="mb-16">
      <h2 class="text-2xl font-display font-bold text-warm-gray-900 mb-8 flex items-center gap-3">
        <span class="inline-block px-3 py-1 bg-secondary-100 text-secondary-700 text-sm font-bold rounded-pill">
          {t('features.page.free.title')}
        </span>
      </h2>
      <div class="grid sm:grid-cols-2 gap-5">
        {freeFeatures.map((feature, index) => (
          <div
            class="p-6 bg-white rounded-card border border-warm-gray-100 hover:shadow-card transition-all flex items-start gap-4 scale-in"
            style={`transition-delay: ${index * 80}ms`}
          >
            <div class="w-12 h-12 bg-primary-50 rounded-soft flex items-center justify-center flex-shrink-0 text-2xl">
              {feature.icon}
            </div>
            <div>
              <h3 class="text-lg font-bold text-warm-gray-900 mb-2">{feature.title}</h3>
              <p class="text-warm-gray-600 text-sm leading-relaxed">{feature.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Premium Features -->
    <section class="mb-16">
      <h2 class="text-2xl font-display font-bold text-warm-gray-900 mb-8 flex items-center gap-3">
        <span class="inline-block px-3 py-1 bg-primary-100 text-primary-700 text-sm font-bold rounded-pill">
          {t('features.page.premium.title')}
        </span>
      </h2>
      <div class="grid sm:grid-cols-2 gap-5">
        {premiumFeatures.map((feature, index) => (
          <div
            class="p-6 bg-primary-50 rounded-card border border-primary-200 hover:shadow-card transition-all flex items-start gap-4 scale-in"
            style={`transition-delay: ${index * 80}ms`}
          >
            <div class="w-12 h-12 bg-white rounded-soft flex items-center justify-center flex-shrink-0 text-2xl shadow-soft">
              {feature.icon}
            </div>
            <div>
              <h3 class="text-lg font-bold text-warm-gray-900 mb-2">{feature.title}</h3>
              <p class="text-warm-gray-600 text-sm leading-relaxed">{feature.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <div class="text-center fade-in-up">
      <CTAButton text={t('features.page.cta')} size="lg" href="/en/#download" />
    </div>
  </div>
</BaseLayout>
