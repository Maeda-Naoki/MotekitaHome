---
import { Check, Circle } from 'lucide-static';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Roadmap - Motekita"
  description="Motekita development roadmap"
>
  <section class="py-32 sm:py-40">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="text-center mb-20">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight">Roadmap</h1>
        <p class="mt-5 text-lg sm:text-xl text-muted-foreground font-light">
          Motekita development roadmap
        </p>
      </div>

      <div class="max-w-3xl mx-auto">
        <!-- Coming Soon -->
        <div class="relative pl-10 pb-16 border-l border-border/60 border-dashed last:pb-0">
          <div class="absolute left-0 top-0.5 w-3 h-3 -translate-x-[7px] rounded-full bg-background border-2 border-muted-foreground/40"></div>
          <div class="mb-3">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-[12px] font-semibold bg-muted text-muted-foreground tracking-wide uppercase">
              Coming Soon
            </span>
          </div>
          <h2 class="text-[19px] font-semibold tracking-tight mt-5 mb-4">Planned Features</h2>
          <ul class="space-y-3 text-muted-foreground">
            <li class="flex items-start gap-3">
              <span class="text-muted-foreground/50 mt-0.5 w-4 h-4 shrink-0 [&>svg]:w-full [&>svg]:h-full" aria-hidden="true" set:html={Circle} />
              <span class="text-[15px]">Spam detection (Premium)</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-muted-foreground/50 mt-0.5 w-4 h-4 shrink-0 [&>svg]:w-full [&>svg]:h-full" aria-hidden="true" set:html={Circle} />
              <span class="text-[15px]">Outlook support (Premium)</span>
            </li>
          </ul>
        </div>

        <!-- Version 1.0.0 -->
        <div class="relative pl-10 pb-16 border-l border-border/60 last:pb-0">
          <div class="absolute left-0 top-0.5 w-3 h-3 -translate-x-[7px] rounded-full bg-primary"></div>
          <div class="mb-3">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-[12px] font-semibold bg-primary text-primary-foreground tracking-wide uppercase">
              v1.0.0
            </span>
            <span class="ml-3 text-[13px] text-muted-foreground">January 2025</span>
          </div>
          <h2 class="text-[19px] font-semibold tracking-tight mt-5 mb-4">Initial Release</h2>
          <ul class="space-y-3 text-muted-foreground">
            <li class="flex items-start gap-3">
              <span class="text-primary mt-0.5 w-4 h-4 shrink-0 [&>svg]:w-full [&>svg]:h-full" aria-hidden="true" set:html={Check} />
              <span class="text-[15px]">New email detection via Gmail IMAP connection</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary mt-0.5 w-4 h-4 shrink-0 [&>svg]:w-full [&>svg]:h-full" aria-hidden="true" set:html={Check} />
              <span class="text-[15px]">Golden Retriever animation notifications</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary mt-0.5 w-4 h-4 shrink-0 [&>svg]:w-full [&>svg]:h-full" aria-hidden="true" set:html={Check} />
              <span class="text-[15px]">System tray resident</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary mt-0.5 w-4 h-4 shrink-0 [&>svg]:w-full [&>svg]:h-full" aria-hidden="true" set:html={Check} />
              <span class="text-[15px]">Windows / macOS / Linux support</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary mt-0.5 w-4 h-4 shrink-0 [&>svg]:w-full [&>svg]:h-full" aria-hidden="true" set:html={Check} />
              <span class="text-[15px]">Complete local processing for privacy</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
