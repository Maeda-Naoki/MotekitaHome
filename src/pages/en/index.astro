---
import FeatureHighlights from '@/components/home/FeatureHighlights.astro';
import FinalCTA from '@/components/home/FinalCTA.astro';
import Hero from '@/components/home/Hero.astro';
import HowItWorks from '@/components/home/HowItWorks.astro';
import PricingSummary from '@/components/home/PricingSummary.astro';
import ValueProposition from '@/components/home/ValueProposition.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Motekita',
  description:
    'A desktop app where a cute Golden Retriever notifies you of new emails. Complete local processing for privacy.',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows 11+, macOS 14+, Linux',
  softwareVersion: '1.0.0',
  downloadUrl: 'https://motekita.netlify.app/en/#download',
  screenshot: 'https://motekita.netlify.app/og-image.svg',
  offers: [
    {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      name: 'Free',
      availability: 'https://schema.org/InStock',
    },
    {
      '@type': 'Offer',
      price: '5',
      priceCurrency: 'USD',
      name: 'Premium',
      availability: 'https://schema.org/InStock',
    },
  ],
  inLanguage: 'en',
  author: {
    '@type': 'Organization',
    name: 'Motekita',
  },
};
---

<BaseLayout
  title="Motekita - Your Dog Tells You When Mail Arrives"
  description="A desktop app where a cute Golden Retriever notifies you of new emails. Available on Windows, macOS, and Linux. Complete local processing for privacy."
  jsonLd={softwareJsonLd}
>
  <link rel="preload" as="image" href="/MailMotekita.svg" slot="head" />
  <Hero />
  <ValueProposition />
  <HowItWorks />
  <FeatureHighlights />
  <PricingSummary />
  <FinalCTA />
</BaseLayout>
