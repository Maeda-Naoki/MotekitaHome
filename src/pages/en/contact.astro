---
import { ChevronRight, Mail } from 'lucide-static';
import { useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

const t = useTranslations('en');
---

<BaseLayout
  title="Contact - Motekita"
  description="Contact Motekita"
>
  <section class="py-32 sm:py-40">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="text-center mb-20">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight">{t('contact.title')}</h1>
        <p class="mt-5 text-lg sm:text-xl text-muted-foreground font-light max-w-2xl mx-auto">
          {t('contact.desc')}
        </p>
      </div>

      <div class="max-w-2xl mx-auto">
        <div class="grid gap-4">
          <!-- Email -->
          <a
            href="mailto:support@motekita.example.com"
            class="flex items-center gap-6 p-8 bg-muted/40 rounded-2xl border border-border/60 hover:border-primary/40 hover:bg-background transition-all duration-300 group"
          >
            <div class="w-13 h-13 rounded-2xl bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform duration-300" aria-hidden="true">
              <span class="w-6 h-6 text-blue-600 dark:text-blue-400 [&>svg]:w-full [&>svg]:h-full" set:html={Mail} />
            </div>
            <div>
              <h2 class="text-[17px] font-semibold tracking-tight">{t('contact.email')}</h2>
              <p class="text-[14px] text-muted-foreground mt-1">
                support@motekita.example.com
              </p>
            </div>
            <span class="w-5 h-5 ml-auto text-muted-foreground/50 group-hover:text-muted-foreground transition-colors duration-200 [&>svg]:w-full [&>svg]:h-full" aria-hidden="true" set:html={ChevronRight} />
          </a>
        </div>

        <div class="mt-16 text-center text-[14px] text-muted-foreground">
          <p>
            We typically respond to inquiries within 1-3 business days.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
