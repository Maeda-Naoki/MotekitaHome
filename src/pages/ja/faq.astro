---
import BaseLayout from '@/layouts/BaseLayout.astro';

const faqs = [
  {
    question: 'Motekita（ﾓﾃｷﾀ）はどのようなアプリですか？',
    answer:
      'Motekita（ﾓﾃｷﾀ）は、メールの受信を監視し、かわいいゴールデンレトリーバーのアニメーションで通知するデスクトップアプリです。単なる通知ツールではなく「ゴールデンレトリーバーと遊んでいる感覚」を提供することを目指しています。',
  },
  {
    question: 'メールの内容は見られますか？',
    answer:
      'いいえ、メールの本文は一切見られません。「誰から」「どんなタイトルのメールが来たか」だけを確認して通知します。あなたのプライバシーは完全に守られます。',
  },
  {
    question: 'どのメールサービスに対応していますか？',
    answer:
      '無料版ではGmailに対応しています。有料版（プレミアム）ではOutlookにも対応します。',
  },
  {
    question: 'データはどこに保存されますか？',
    answer:
      'すべてのデータはあなたのパソコンの中だけに保存されます。インターネットにデータを送信することは一切ありません。認証情報もパソコン内に安全に保存されるので、安心してお使いいただけます。',
  },
  {
    question: '無料版と有料版の違いは何ですか？',
    answer:
      '無料版はGmailの通知と基本的なゴールデンレトリーバーのアニメーションが使えます。有料版（500円買い切り）では、スパム判定機能とOutlook対応が追加されます。',
  },
  {
    question: 'DLC（追加コンテンツ）とは何ですか？',
    answer:
      'DLCでは追加の犬種（柴犬、ハスキーなど）や衣装を購入できます。これらは純粋にカスタマイズ用で、アプリの基本機能には影響しません。',
  },
  {
    question: 'アプリの動作が重くなりませんか？',
    answer:
      'いいえ、とても軽いアプリです。バックグラウンドで動いていても、パソコンの動作に影響を与えることはほとんどありません。普段通りに作業をしながら快適にお使いいただけます。',
  },
  {
    question: 'サポートを受けるにはどうすればいいですか？',
    answer: 'お問い合わせページからご連絡ください。',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title="よくある質問 - Motekita"
  description="Motekitaに関するよくある質問と回答"
  jsonLd={faqJsonLd}
>
  <section class="py-32 sm:py-40">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="text-center mb-20">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight">よくある質問</h1>
        <p class="mt-5 text-lg sm:text-xl text-muted-foreground font-light">
          Motekita（ﾓﾃｷﾀ）についてのよくある質問をまとめました
        </p>
      </div>

      <div class="max-w-3xl mx-auto space-y-3">
        {faqs.map((faq) => (
          <details class="group bg-muted/40 rounded-2xl border border-border/60 p-7 open:bg-background transition-colors duration-200">
            <summary class="flex cursor-pointer items-center justify-between font-semibold text-[15px] list-none">
              <span>{faq.question}</span>
              <span class="ml-4 shrink-0 transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
                <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-5 text-[15px] text-muted-foreground leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
