---
import { PawPrint } from 'lucide-static';
import {
  getLangFromUrl,
  getLocalizedPath,
  useTranslations,
} from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const footerLinks = [
  { href: getLocalizedPath('/terms', lang), label: t('footer.terms') },
  { href: getLocalizedPath('/privacy', lang), label: t('footer.privacy') },
  { href: getLocalizedPath('/roadmap', lang), label: t('footer.changelog') },
  { href: getLocalizedPath('/contact', lang), label: t('footer.contact') },
];
---

<footer class="border-t border-border/40">
  <div class="container mx-auto px-6 lg:px-8 py-16">
    <div class="flex flex-col md:flex-row justify-between items-center gap-10">
      <div class="flex items-center gap-2.5">
        <span class="w-5 h-5 text-muted-foreground [&>svg]:w-full [&>svg]:h-full" aria-hidden="true" set:html={PawPrint} />
        <span class="text-[17px] font-semibold tracking-tight">Motekita</span>
      </div>

      <nav class="flex flex-wrap justify-center gap-8" aria-label={lang === 'ja' ? 'フッターナビゲーション' : 'Footer navigation'}>
        {footerLinks.map((link) => (
          <a
            href={link.href}
            class="text-[13px] text-muted-foreground hover:text-foreground transition-colors duration-200"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="mt-12 pt-8 border-t border-border/40 text-center text-[12px] text-muted-foreground">
      {t('footer.copyright')}
    </div>
  </div>
</footer>
