---
import { Monitor, Shield, Zap } from 'lucide-static';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
  {
    icon: Shield,
    title: t('features.privacy.title'),
    description: t('features.privacy.desc'),
  },
  {
    icon: Zap,
    title: t('features.lightweight.title'),
    description: t('features.lightweight.desc'),
  },
  {
    icon: Monitor,
    title: t('features.crossplatform.title'),
    description: t('features.crossplatform.desc'),
  },
];
---

<section id="features" class="py-32 sm:py-40 bg-muted/60" aria-labelledby="features-heading">
  <div class="container mx-auto px-6 lg:px-8">
    <div class="text-center mb-20">
      <h2 id="features-heading" class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight">{t('features.title')}</h2>
      <p class="mt-5 text-lg sm:text-xl text-muted-foreground font-light max-w-2xl mx-auto">{t('features.subtitle')}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((feature) => (
        <div class="bg-background rounded-2xl p-9 border border-border/60 hover:border-border transition-colors duration-300">
          <div class="w-12 h-12 mb-6 text-primary [&>svg]:w-full [&>svg]:h-full" aria-hidden="true" set:html={feature.icon} />
          <h3 class="text-[19px] font-semibold tracking-tight mb-3">{feature.title}</h3>
          <p class="text-muted-foreground leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
