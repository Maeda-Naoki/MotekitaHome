---
import CTAButton from '@/components/common/CTAButton.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="download" class="py-20 md:py-28 px-4 relative overflow-hidden">
  <!-- 装飾背景 -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary-50/80 via-cream-50 to-secondary-50/40" aria-hidden="true"></div>
  <div class="absolute top-[-40px] right-[-60px] w-[200px] h-[200px] bg-primary-100/50 blob-shape" aria-hidden="true"></div>
  <div class="absolute bottom-[-30px] left-[-40px] w-[160px] h-[160px] bg-secondary-100/30 blob-shape" aria-hidden="true" style="border-radius: 40% 60% 55% 45% / 55% 40% 60% 45%;"></div>

  <div class="max-w-3xl mx-auto relative z-10">
    <div class="bg-white/80 backdrop-blur-sm rounded-card p-8 md:p-12 shadow-card border border-warm-gray-100 text-center">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-warm-gray-900 mb-4 fade-in-up">
        {t('finalCTA.title')}
      </h2>
      <p class="text-lg text-warm-gray-600 mb-8 max-w-xl mx-auto fade-in-up" style="transition-delay: 80ms">
        {t('finalCTA.subtitle')}
      </p>
      <div class="fade-in-up flex flex-col sm:flex-row justify-center gap-4 items-center" style="transition-delay: 160ms">
        <CTAButton text={t('finalCTA.cta')} size="lg" />
        <p class="text-sm text-warm-gray-500">{lang === 'ja' ? 'Windows / macOS / Linux 対応' : 'Windows / macOS / Linux'}</p>
      </div>

      <!-- Platform icons -->
      <div class="mt-8 flex justify-center gap-6 fade-in-up" style="transition-delay: 240ms" aria-hidden="true">
        <!-- Windows -->
        <svg class="w-6 h-6 text-warm-gray-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/>
        </svg>
        <!-- macOS -->
        <svg class="w-6 h-6 text-warm-gray-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        <!-- Linux -->
        <svg class="w-6 h-6 text-warm-gray-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.504 0c-.155 0-.311.001-.465.003C9.517.077 7.157 1.565 5.765 3.53 4.373 5.495 3.867 7.952 4.37 10.3c.503 2.348 1.943 4.43 3.978 5.688 2.035 1.258 4.538 1.63 6.86.997 2.321-.633 4.292-2.208 5.42-4.322 1.128-2.115 1.334-4.602.561-6.856-.773-2.254-2.442-4.124-4.605-5.086C15.272.277 13.9 0 12.504 0z"/>
        </svg>
      </div>
    </div>
  </div>
</section>
