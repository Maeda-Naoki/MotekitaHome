---
import CTAButton from '@/components/common/CTAButton.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="min-h-[80vh] flex items-center px-4 py-16 md:py-24 relative overflow-hidden">
  <!-- 装飾: 有機的なブロブ背景 -->
  <div class="absolute top-12 right-[-8%] w-[340px] h-[340px] md:w-[480px] md:h-[480px] bg-primary-100/60 blob-shape" aria-hidden="true"></div>
  <div class="absolute bottom-[-5%] left-[-4%] w-[200px] h-[200px] md:w-[280px] md:h-[280px] bg-secondary-100/40 blob-shape" aria-hidden="true" style="border-radius: 40% 60% 70% 30% / 40% 50% 50% 60%;"></div>

  <div class="max-w-6xl mx-auto w-full relative z-10">
    <div class="grid md:grid-cols-[1.1fr_0.9fr] gap-8 md:gap-12 items-center">
      <!-- テキスト側 -->
      <div class="md:text-left text-center">
        <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-display font-bold text-warm-gray-900 leading-[1.15] mb-6 tracking-tight slide-in-left">
          {lang === 'ja' ? (
            <>
              <span class="block">メールが届くと、</span>
              <span class="block text-primary-700">ゴールデンレトリーバーが</span>
              <span class="block">教えてくれる</span>
            </>
          ) : (
            <>
              <span class="block">Your Dog Tells You</span>
              <span class="block text-primary-700">When Mail</span>
              <span class="block">Arrives</span>
            </>
          )}
        </h1>
        <p class="mt-6 text-lg md:text-xl text-warm-gray-600 max-w-lg slide-in-left" style="transition-delay: 100ms">
          {t('hero.subtitle')}
        </p>
        <div class="mt-10 flex flex-col sm:flex-row items-center md:items-start gap-4 slide-in-left" style="transition-delay: 200ms">
          <CTAButton text={t('hero.cta')} size="lg" />
          <a
            href={getLocalizedPath('/features', lang)}
            class="text-warm-gray-600 hover:text-primary-700 font-medium transition-colors text-base"
          >
            {t('hero.cta.secondary')} →
          </a>
        </div>
      </div>

      <!-- ビジュアル側 -->
      <div class="relative flex items-center justify-center slide-in-right" style="transition-delay: 150ms" aria-hidden="true">
        <div class="relative w-64 h-64 md:w-80 md:h-80">
          <!-- メインサークル -->
          <div class="absolute inset-0 rounded-full bg-gradient-to-br from-primary-100 to-primary-200/80 flex items-center justify-center overflow-hidden">
            <img
              src="/MailMotekita.svg"
              alt=""
              width="160"
              height="160"
              class="w-40 h-40 md:w-52 md:h-52"
            />
          </div>
          <!-- 装飾リング -->
          <div class="absolute inset-[-12px] rounded-full border-2 border-dashed border-primary-200/60"></div>
          <div class="absolute inset-[-28px] rounded-full border border-primary-100/40"></div>
          <!-- 浮遊するタグ -->
          <div class="absolute top-[-8px] right-[10%] bg-white shadow-card rounded-soft px-3 py-1.5 text-sm font-bold text-secondary-700">
            📧 {lang === 'ja' ? 'メール通知' : 'Mail Alerts'}
          </div>
          <div class="absolute bottom-[10%] left-[-5%] bg-white shadow-card rounded-soft px-3 py-1.5 text-sm font-bold text-primary-700">
            🐕 Motekita
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
