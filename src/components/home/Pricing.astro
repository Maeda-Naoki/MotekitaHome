---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="pricing" class="py-32 sm:py-40" aria-labelledby="pricing-heading">
  <div class="container mx-auto px-6 lg:px-8">
    <div class="text-center mb-20">
      <h2 id="pricing-heading" class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight">{t('pricing.title')}</h2>
      <p class="mt-5 text-lg sm:text-xl text-muted-foreground font-light">{t('pricing.subtitle')}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      <!-- Free Plan -->
      <div class="bg-muted/60 rounded-2xl p-10 border border-border/60">
        <h3 class="text-[22px] font-semibold tracking-tight">{t('pricing.free')}</h3>
        <div class="mt-5">
          <span class="text-5xl font-semibold tracking-tight">{t('pricing.free.price')}</span>
        </div>
        <p class="mt-5 text-muted-foreground leading-relaxed">{t('pricing.free.desc')}</p>
        <ul class="mt-10 space-y-4">
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-[15px]">{t('pricing.free.feature1')}</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-[15px]">{t('pricing.free.feature2')}</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-[15px]">{t('pricing.free.feature3')}</span>
          </li>
        </ul>
        <a
          href="#download"
          class="mt-10 block w-full text-center rounded-full border border-border bg-background px-4 py-3.5 text-[15px] font-semibold hover:bg-muted transition-colors duration-200"
        >
          {t('hero.cta')}
        </a>
      </div>

      <!-- Premium Plan -->
      <div class="bg-foreground text-background rounded-2xl p-10 relative">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-amber-500 text-white text-[12px] font-semibold px-4 py-1 rounded-full tracking-wide uppercase">
          Popular
        </div>
        <h3 class="text-[22px] font-semibold tracking-tight">{t('pricing.premium')}</h3>
        <div class="mt-5">
          <span class="text-5xl font-semibold tracking-tight">{t('pricing.premium.price')}</span>
          <span class="text-[13px] opacity-60 ml-2">{t('pricing.premium.once')}</span>
        </div>
        <p class="mt-5 opacity-70 leading-relaxed">{t('pricing.premium.desc')}</p>
        <ul class="mt-10 space-y-4">
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-[15px]">{t('pricing.premium.feature1')}</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-[15px]">{t('pricing.premium.feature2')}</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-[15px]">{t('pricing.premium.feature3')}</span>
          </li>
        </ul>
        <a
          href="#download"
          class="mt-10 block w-full text-center rounded-full bg-amber-500 text-white px-4 py-3.5 text-[15px] font-semibold hover:bg-amber-400 transition-colors duration-200"
        >
          {t('hero.cta')}
        </a>
      </div>
    </div>
  </div>
</section>
