---
import { getLangFromUrl, getLocalizedPath, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const featuresUrl = getLocalizedPath('/features', lang);

const features = [
  {
    icon: '🔒',
    title: t('features.privacy.title'),
    description: t('features.privacy.desc'),
  },
  {
    icon: '⚡',
    title: t('features.lightweight.title'),
    description: t('features.lightweight.desc'),
  },
  {
    icon: '💻',
    title: t('features.crossplatform.title'),
    description: t('features.crossplatform.desc'),
  },
  {
    icon: '🎯',
    title: t('features.spamdetection.title'),
    description: t('features.spamdetection.desc'),
  },
  {
    icon: '📬',
    title: t('features.outlook.title'),
    description: t('features.outlook.desc'),
  },
  {
    icon: '🐕',
    title: t('features.animation.title'),
    description: t('features.animation.desc'),
  },
];
---

<section class="py-16 md:py-24 px-4 relative overflow-hidden">
  <!-- 装飾: 斜めストライプ背景 -->
  <div class="absolute top-0 right-0 w-1/3 h-full stripe-accent opacity-40 pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-warm-gray-900 mb-3 fade-in-up">
        {t('featureHighlights.title')}
      </h2>
      <div class="w-12 h-1 bg-primary-400 rounded-full mx-auto fade-in-up"></div>
    </div>

    <!-- グリッド: 最初の機能を横幅いっぱいに -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
      {features.map((feature, index) => {
        const isFirst = index === 0;
        return (
          <div
            class:list={[
              "p-6 bg-white rounded-card border border-warm-gray-100 hover:shadow-card transition-all",
              isFirst ? "sm:col-span-2 lg:col-span-2 flex items-start gap-6 slide-in-left" : "scale-in",
            ]}
            style={`transition-delay: ${index * 80}ms`}
          >
            <div class:list={[
              "flex-shrink-0 rounded-soft flex items-center justify-center",
              isFirst ? "w-14 h-14 bg-primary-50 text-3xl" : "w-11 h-11 bg-primary-50 text-2xl mb-3"
            ]}>
              {feature.icon}
            </div>
            <div>
              <h3 class:list={[
                "font-bold text-warm-gray-900 mb-2",
                isFirst ? "text-xl" : "text-lg"
              ]}>
                {feature.title}
              </h3>
              <p class:list={[
                "text-warm-gray-600",
                isFirst ? "text-base leading-relaxed" : "text-sm"
              ]}>
                {feature.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>

    <div class="fade-in-up">
      <a
        href={featuresUrl}
        class="inline-flex items-center gap-1.5 text-primary-700 hover:text-primary-800 font-bold transition-colors group"
      >
        {t('featureHighlights.cta')}
        <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
