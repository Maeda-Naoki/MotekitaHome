---
import Footer from '@/components/common/Footer.astro';
import Header from '@/components/common/Header.astro';
import SEO from '@/components/common/SEO.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale || 'ja'}>
  <head>
    <SEO title={title} description={description} />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a href="#main-content" class="skip-link">
      {Astro.currentLocale === 'en' ? 'Skip to main content' : '本文へスキップ'}
    </a>
    <Header />
    <main id="main-content" class="container mx-auto px-6 lg:px-8 py-20 sm:py-28">
      <article class="prose max-w-3xl mx-auto">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-12">{title}</h1>
        <slot />
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .prose {
    --tw-prose-body: hsl(var(--foreground));
    --tw-prose-headings: hsl(var(--foreground));
    --tw-prose-links: hsl(var(--primary));
    --tw-prose-bold: hsl(var(--foreground));
    --tw-prose-counters: hsl(var(--muted-foreground));
    --tw-prose-bullets: hsl(var(--muted-foreground));
    --tw-prose-hr: hsl(var(--border));
    --tw-prose-quotes: hsl(var(--foreground));
    --tw-prose-quote-borders: hsl(var(--border));
    --tw-prose-code: hsl(var(--foreground));
    --tw-prose-pre-bg: hsl(var(--muted));
  }

  .prose h2 {
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .prose h3 {
    margin-top: 2.25rem;
    margin-bottom: 1rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
  }

  .prose ul {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    list-style-type: disc;
  }

  .prose li {
    margin-bottom: 0.625rem;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
  }

  .prose a {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose a:hover {
    opacity: 0.75;
  }

  .prose hr {
    margin: 3rem 0;
    border-color: hsl(var(--border));
    opacity: 0.6;
  }
</style>
